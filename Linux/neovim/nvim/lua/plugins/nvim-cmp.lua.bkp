
return {
  {
    'hrsh7th/nvim-cmp',
    event = 'InsertEnter', -- Lazy loads the plugin only when you enter Insert mode
    dependencies = {
      'hrsh7th/cmp-nvim-lsp',     -- Completion source for Neovim's built-in LSP
      'hrsh7th/cmp-buffer',       -- Completion source for words in the current buffer
      'hrsh7th/cmp-path',         -- Completion source for system file paths
      'L3MON4D3/LuaSnip',         -- Snippet engine required for expansion
      'saadparwaiz1/cmp_luasnip', -- Adapter to map LuaSnip into nvim-cmp
      'rafamadriz/friendly-snippets', -- A library of global snippets
    },
    config = function()
      local cmp = require('cmp')
      local luasnip = require('luasnip')

      -- Load user-friendly snippets (e.g., vscode-style snippets)
      require('luasnip.loaders.from_vscode').lazy_load()

      cmp.setup({
        snippet = {
          expand = function(args)
            luasnip.lsp_expand(args.body)
          end,
        },
        mapping = cmp.mapping.preset.insert({
          ['<C-b>'] = cmp.mapping.scroll_docs(-4),
          ['<C-f>'] = cmp.mapping.scroll_docs(4),
          ['<C-Space>'] = cmp.mapping.complete(), -- Manually trigger completion
          ['<C-e>'] = cmp.mapping.abort(),
          ['<CR>'] = cmp.mapping.confirm({ select = true }), -- Accept selected item
        }),
        sources = cmp.config.sources({
          { name = 'nvim_lsp' }, -- LSP completion
          { name = 'luasnip' },  -- Snippets
        }, {
          { name = 'buffer' },   -- Buffer words fallback
          { name = 'path' },     -- File system path fallback
        })
      })
    end
  }
}

